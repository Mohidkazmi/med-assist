# =========================================================================
# AI Medical Scribe Platform - Environment Variables Template
# Copy this file to `.env` and fill in the values for local development.
# =========================================================================

# --- PostgreSQL Settings ---
POSTGRES_DB=med_scribe_dev
POSTGRES_USER=scribe_admin
# WARNING: Always change the password in production environments!
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5433

# --- pgAdmin Settings ---
PGADMIN_DEFAULT_EMAIL=admin@medscribe.com
# WARNING: Use a strong password for pgAdmin dashboard
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# --- Backend Settings ---
BACKEND_PORT=8000

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8000/api/v1


